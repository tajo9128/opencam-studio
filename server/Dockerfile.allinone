FROM alpine:3.22 AS mlt-builder

RUN apk add --no-cache \
    build-base cmake pkgconfig musl-dev linux-headers \
    ffmpeg-dev libxml2-dev libsamplerate-dev \
    frei0r-plugins-dev libexif-dev libvorbis-dev opus-dev

WORKDIR /src
RUN wget -qO mlt.tar.gz https://github.com/mltframework/mlt/archive/refs/tags/v7.26.0.tar.gz && \
    tar xzf mlt.tar.gz && mv mlt-* mlt

RUN rm -rf /src/mlt/src/modules/rtaudio /src/mlt/src/modules/plus && \
    mkdir -p /src/mlt/src/modules/rtaudio /src/mlt/src/modules/plus && \
    printf 'RETURN()\n' > /src/mlt/src/modules/rtaudio/CMakeLists.txt && \
    printf 'RETURN()\n' > /src/mlt/src/modules/plus/CMakeLists.txt

WORKDIR /src/mlt/build
RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -j$(nproc) && \
    make install

FROM alpine:3.22 AS llama-builder
RUN apk add --no-cache cmake make g++ git curl
WORKDIR /src
# Pin to a specific stable llama.cpp release tag (e.g. b2900 or later)
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git
WORKDIR /src/llama.cpp
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLAMA_STATIC=ON && \
    cmake --build build --config Release --target llama-server -j$(nproc) && \
    strip build/bin/llama-server

FROM alpine:3.22 AS model-downloader
RUN apk add --no-cache curl
WORKDIR /models
# Download Meta-Llama-3.2-3B-Instruct-Q4_K_M (~2.02GB)
RUN curl -L -o llama-3.2-3b-instruct-q4_k_m.gguf \
    "https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF/resolve/main/Llama-3.2-3B-Instruct-Q4_K_M.gguf?download=true"

FROM node:22-alpine3.22 AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine3.22

RUN apk upgrade --no-cache && apk add --no-cache \
    ffmpeg frei0r-plugins nginx libstdc++ \
    libxml2 libsamplerate libexif libvorbis opus

COPY --from=mlt-builder /usr/local /usr/local
COPY --from=llama-builder /src/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=model-downloader /models /models

ENV MLT_PATH=/usr/local/lib/mlt-7 \
    MLT_REPOSITORY=/usr/local/lib/mlt-7 \
    PATH=/usr/local/bin:${PATH} \
    LLM_MODEL_PATH=/models/llama-3.2-3b-instruct-q4_k_m.gguf \
    LLM_PORT=8084 \
    LLM_THREADS=4 \
    LLM_CTX_SIZE=2048

WORKDIR /app

COPY server/package*.json ./
RUN npm ci --omit=dev

COPY server/project-server.js server/mlt-xml.js server/job-queue.js server/recording-server.js server/rtmp-relay.js server/signaling-server.js ./
COPY server/middleware/ ./middleware/
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx-docker.conf /etc/nginx/conf.d/default.conf
COPY server/start.sh /app/start.sh
RUN chmod +x /app/start.sh && \
    mkdir -p /videos/.uploads /proxies /projects /output /recordings

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

RUN addgroup -S opencam && adduser -S opencam -G opencam
RUN chown -R opencam:opencam /app /videos /proxies /projects /output /recordings /models /var/lib/nginx /var/log/nginx /etc/nginx/conf.d /tmp
RUN chmod 755 /var/log/nginx

CMD ["/app/start.sh"]

