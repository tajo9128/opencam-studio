# OpenCam Studio Environment Variables
# Copy this file to .env and fill in the values

# === Server Ports ===
PORT=8082
RECORDING_PORT=8081
SIGNALING_PORT=8083
RTMP_PORT=8080

# === Directories ===
RECORDINGS_DIR=/recordings
PROXIES_DIR=/proxies
OUTPUT_DIR=/output
VIDEOS_DIR=/videos
PROJECTS_DIR=/projects

# === Security ===
# API key for server endpoints (leave empty for development - no auth required)
OPENCAM_API_KEY=

# CORS origins (comma-separated, defaults to http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# === AI Configuration ===
# Ollama endpoint (for local LLM)
OLLAMA_URL=http://localhost:11434

# === Rate Limiting ===
# Requests per minute per IP (default: 200)
RATE_LIMIT_MAX=200
# Rate limit window in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# === Upload Limits ===
# Maximum upload file size in bytes (default: 50GB)
MAX_UPLOAD_SIZE=53687091200

# === Recording ===
# Maximum recording duration in seconds (default: 3600 = 1 hour)
MAX_RECORDING_DURATION=3600
